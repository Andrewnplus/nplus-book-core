{{- /*
  星系共用：每本 handbook / 書 build 出 /index.json，供 nplus-father portal 匯總「已 review」進度。
  reviewable 單位 = docs/ 底下每個 _index.md（一個主題頁）；每筆另帶 `leaf`
  （true = 底下沒有子頁，即真正的葉章節），讓消費端自行決定要算全部頁或只算葉章節。
  某頁「已 review」的判準：frontmatter `reviewed: true`（可再加 `reviewedDate: "YYYY-MM-DD"`；
  `/read-review` skill 與 handbooks 既有頁面寫的是 `reviewed_date`，兩種 key 都吃）。
  books-done 的 Hugo 書用 `read` / `readAt` 慣例，這裡一併吃並映射到同樣的欄位。
  未設 = 未 review（乾淨基線，不需逐頁 stamp）。

  `kind` 預設 "book"，由手冊自行覆寫——站台數量懸殊（約 1620 本書 vs 11 本
  手冊），讓少數的一邊宣告成本最低。手冊在自己的 hugo.toml 加：
      [params]
      stationKind = "handbook"
*/ -}}
{{- $items := slice -}}
{{- range where site.Pages "Section" "docs" -}}
  {{- if .File -}}
    {{- $reviewed := or (eq .Params.reviewed true) (eq .Params.read true) -}}
    {{- $reviewedDate := or .Params.reviewedDate .Params.reviewed_date .Params.readAt | default "" -}}
    {{- /*
      `chars` counts runes, not bytes: `len` would report CJK at three times its
      length and make Chinese books look enormous next to English ones. Lines
      that are exactly `---` are dropped so this matches BookHealthService's
      local scan, which cannot tell a body rule from a frontmatter fence and
      therefore skips both.
    */ -}}
    {{- /*
      The trailing newline is trimmed before splitting: `split "a\n" "\n"`
      yields a final empty element, which would add one character per page.
    */ -}}
    {{- $chars := 0 -}}
    {{- with .RawContent -}}
      {{- /* `split "" "\n"` still yields one empty element, so a section index
             with nothing but frontmatter would otherwise report one character. */ -}}
      {{- range (split (strings.TrimSuffix "\n" .) "\n") -}}
        {{- if ne (trim . " \t\r") "---" -}}
          {{- $chars = add $chars (add (strings.RuneCount .) 1) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $items = $items | append (dict
        "id" .File.Path
        "title" .Title
        "url" .Permalink
        "weight" .Weight
        "leaf" (eq (len .Pages) 0)
        "chars" $chars
        "reviewed" $reviewed
        "reviewedDate" $reviewedDate
    ) -}}
  {{- end -}}
{{- end -}}
{{- /*
  `book` republishes the home page's `book:` frontmatter — title, author,
  publication date, purchase link and the one-line blurb. The portal used to
  recover these by splitting the GitHub repo description on "|": a positional
  format capped at 350 characters that silently shifted every field if a title
  contained a separator. Here they are named fields with no length limit,
  emitted by the site that owns them.

  Empty on sites not yet migrated, so consumers must keep their fallback.
*/ -}}
{{- $book := dict -}}
{{- with site.Home.Params.book -}}
  {{- $book = . -}}
{{- end -}}
{{- /*
  `overview` reports the state of the home page's deep overview, so the portal
  can show how far the four-section rewrite has got without anyone running a
  local scan over 1,700 clones — the same move `chars` above made for content
  health.

  `state` keys on the shortcode call, exactly as `overview-lanes/next.sh` and
  `OverviewCoverageService.stateOf` do; all three have to agree on what "done"
  means, or the dashboard will contradict the tool that writes the books. The
  marker is matched without its closing `%}}` so the literal never has to carry
  `}}` through the template lexer.

  `sections` counts runes with whitespace removed, matching audit-overview.py's
  `zh_len`, and the portal compares those to the thresholds that audit enforces.
  Only the four canonical headings count, and only until the closing shortcode:
  a legacy page therefore reports zeros rather than the lengths of its three old
  headings, which is the honest answer for a book not yet rewritten.
*/ -}}
{{- $overviewNames := slice "作者的位置" "完整摘要" "定位" "這本書的限制" -}}
{{- $sections := dict -}}
{{- range $overviewNames -}}
  {{- $sections = merge $sections (dict . 0) -}}
{{- end -}}
{{- $home := site.Home.RawContent -}}
{{- $state := "none" -}}
{{- if strings.Contains $home "{{% book-overview" -}}
  {{- $state = "done" -}}
{{- else if strings.Contains $home "深度概覽" -}}
  {{- $state = "legacy" -}}
{{- end -}}
{{- if eq $state "done" -}}
  {{- $current := "" -}}
  {{- range (split $home "\n") -}}
    {{- $line := trim . " \t\r" -}}
    {{- if strings.Contains $line "{{% /book-overview" -}}
      {{- $current = "" -}}
    {{- else if hasPrefix $line "## " -}}
      {{- $name := trim (strings.TrimPrefix "## " $line) " " -}}
      {{- $current = cond (in $overviewNames $name) $name "" -}}
    {{- else if ne $current "" -}}
      {{- /*
        Go's `\s` is ASCII-only while python's is Unicode-aware, so a full-width
        space would be counted here and dropped there. No home page carries one
        today (checked all 1,754), but the two implementations have to stay
        interchangeable, so the class is widened rather than left to luck.
      */ -}}
      {{- $n := strings.RuneCount (replaceRE "[\\s\\x{00a0}\\x{3000}\\x{feff}\\x{200b}]" "" $line) -}}
      {{- $sections = merge $sections (dict $current (add (index $sections $current) $n)) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $overviewChars := 0 -}}
{{- range $overviewNames -}}
  {{- $overviewChars = add $overviewChars (index $sections .) -}}
{{- end -}}
{{- dict
    "station" (path.Base (strings.TrimSuffix "/" site.BaseURL))
    "brand" site.Title
    "kind" (site.Params.stationKind | default "book")
    "book" $book
    "overview" (dict "state" $state "chars" $overviewChars "sections" $sections)
    "count" (len $items)
    "items" $items
  | jsonify (dict "indent" "  ") -}}
